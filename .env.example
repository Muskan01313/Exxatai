# Postgres connection (see docker-compose.yml for local dev)
DATABASE_URL="postgresql://notion:notion@localhost:5432/notion_ai?schema=public"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# AI text/chat provider: "openai" | "anthropic"
AI_TEXT_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# AI embedding provider (for "Ask AI about your workspace"): "openai" | "voyage"
# Anthropic does not offer an embeddings API, so this is configured separately.
AI_EMBEDDING_PROVIDER="openai"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
VOYAGE_API_KEY=""
VOYAGE_EMBEDDING_MODEL="voyage-3-lite"

# Tracker reminder emails (optional). See "Tracker reminder emails" in the README.
RESEND_API_KEY=""
REMINDER_FROM_EMAIL=""
CRON_SECRET=""
APP_URL=""
